def savefig(name):
    """Save the current matplotlib figure to output_plots/<name>.png and close it."""
    path = os.path.join(PLOT_DIR, name)
    plt.savefig(path, dpi=120, bbox_inches='tight')
    plt.close()
    print(f'[saved plot] {path}')


def section(title):
    print('\n' + '=' * 90)
    print(title)
    print('=' * 90)


def get_feature_names_compat(transformer, input_features=None):
    """Compatibility wrapper: newer sklearn uses get_feature_names_out(),
    older sklearn (<1.0) uses get_feature_names(). Supports both."""
    if hasattr(transformer, 'get_feature_names_out'):
        try:
            return list(transformer.get_feature_names_out(input_features))
        except TypeError:
            return list(transformer.get_feature_names_out())
    # older sklearn API
    if input_features is not None:
        return list(transformer.get_feature_names(input_features))
    return list(transformer.get_feature_names())


