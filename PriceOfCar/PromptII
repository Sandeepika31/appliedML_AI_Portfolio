section('DATA PREPARATION')

df = df_raw.copy()
print('Starting rows:', len(df))

# ---- 1. Drop pure-identifier / excessive-cardinality / redundant columns ----
df = df.drop(columns=['id', 'VIN', 'model', 'region'])
print('After dropping id/VIN/model/region:', df.shape)

# ---- 2. Remove rows with missing critical numeric fields -------------------
before = len(df)
df = df.dropna(subset=['price', 'year', 'odometer'])
print(f'Dropped {before - len(df):,} rows missing price/year/odometer -> {len(df):,} rows remain')

# ---- 3. Filter out implausible / outlier values -----------------------------
before = len(df)
df = df[(df['price'] >= 500) & (df['price'] <= 150000)]
print(f'Price filter [500, 150000]: dropped {before - len(df):,} rows -> {len(df):,} remain')

before = len(df)
df = df[(df['year'] >= 1990) & (df['year'] <= 2022)]
print(f'Year filter [1990, 2022]: dropped {before - len(df):,} rows -> {len(df):,} remain')

before = len(df)
df = df[(df['odometer'] >= 0) & (df['odometer'] <= 300000)]
print(f'Odometer filter [0, 300000]: dropped {before - len(df):,} rows -> {len(df):,} remain')

# ---- 4. Feature engineering --------------------------------------------------
CURRENT_YEAR = 2022   # dataset vintage (max year observed)
df['age'] = CURRENT_YEAR - df['year']
df['miles_per_year'] = df['odometer'] / df['age'].replace(0, 1)
print('\n--- age / miles_per_year describe() ---')
print(df[['year', 'age', 'odometer', 'miles_per_year']].describe())

# ---- 5. Impute missing categorical values with an explicit 'unknown' level --
cat_cols = ['manufacturer', 'condition', 'cylinders', 'fuel', 'title_status',
            'transmission', 'drive', 'size', 'type', 'paint_color', 'state']

for col in cat_cols:
    df[col] = df[col].fillna('unknown').astype(str).str.strip()

print('\n--- NA count after imputation (should be 0) ---')
print(df[cat_cols].isna().sum())

# ---- 6. Simplify 'cylinders' to a numeric feature where possible -----------
cyl_map = {
    '3 cylinders': 3, '4 cylinders': 4, '5 cylinders': 5, '6 cylinders': 6,
    '8 cylinders': 8, '10 cylinders': 10, '12 cylinders': 12,
    'other': np.nan, 'unknown': np.nan,
}
df['cylinders_num'] = df['cylinders'].map(cyl_map)
df['cylinders_num'] = df['cylinders_num'].fillna(df['cylinders_num'].median())
print('\n--- cylinders -> cylinders_num mapping ---')
print(df[['cylinders', 'cylinders_num']].drop_duplicates().sort_values('cylinders_num'))

# ---- 7. Log-transform the (right-skewed) target and odometer ----------------
df['log_price'] = np.log1p(df['price'])
df['log_odometer'] = np.log1p(df['odometer'])

fig, axes = plt.subplots(1, 2, figsize=(14, 5))
sns.histplot(df['price'], bins=60, ax=axes[0], color='steelblue')
axes[0].set_title('Price (raw) -- right-skewed')
sns.histplot(df['log_price'], bins=60, ax=axes[1], color='seagreen')
axes[1].set_title('log(1 + Price) -- much closer to normal')
plt.tight_layout()
savefig('04_price_log_transform.png')

# ---- 8. Final feature set for modeling --------------------------------------
numeric_features = ['age', 'log_odometer', 'cylinders_num']
categorical_features = ['manufacturer', 'condition', 'fuel', 'title_status',
                         'transmission', 'drive', 'size', 'type', 'paint_color', 'state']

model_df = df[numeric_features + categorical_features + ['log_price', 'price']].copy()
print('\nFinal modeling dataset shape:', model_df.shape)
print(model_df.head())

# ---- 9. Train / test split ---------------------------------------------------
X = model_df[numeric_features + categorical_features]
y = model_df['log_price']          # model in log-space; inverse-transform for reporting
y_dollars = model_df['price']      # keep original price aligned for evaluation

X_train, X_test, y_train, y_test, y_train_d, y_test_d = train_test_split(
    X, y, y_dollars, test_size=0.2, random_state=RANDOM_STATE
)
print('\nTrain shape:', X_train.shape, ' Test shape:', X_test.shape)

# ---- 10. Preprocessing pipeline: scale numeric, one-hot encode categorical --
preprocessor = ColumnTransformer(transformers=[
    ('num', StandardScaler(), numeric_features),
    ('cat', OneHotEncoder(handle_unknown='ignore', sparse=True), categorical_features),
])
print('\nPreprocessor:', preprocessor)

# ---------------------------------------------------------------------------
# Modeling
# ---------------------------------------------------------------------------
section('MODELING')

print("""
We model log(1 + price) as the target (rather than raw price) because the
price distribution is strongly right-skewed; modeling in log-space
stabilizes variance and makes the linear-model assumptions more reasonable.
All reported dollar-scale metrics (RMSE, MAE) below are computed after
inverse-transforming predictions back to raw price (np.expm1).

We compare four regression approaches:
1. Linear Regression (baseline, no regularization)
2. Ridge Regression (L2-regularized, tuned via GridSearchCV)
3. Lasso Regression (L1-regularized, tuned via GridSearchCV)
4. Random Forest Regressor (non-linear benchmark)
""")


def eval_model(name, pipe, X_tr, y_tr_log, X_te, y_te_log, y_te_dollars):
    """Fit pipe on train (log target), evaluate in dollar-space on test."""
    pipe.fit(X_tr, y_tr_log)
    pred_log_tr = pipe.predict(X_tr)
    pred_log_te = pipe.predict(X_te)

    pred_dollars_te = np.expm1(pred_log_te)

    r2_log_tr = r2_score(y_tr_log, pred_log_tr)
    r2_log_te = r2_score(y_te_log, pred_log_te)

    rmse_te = np.sqrt(mean_squared_error(y_te_dollars, pred_dollars_te))
    mae_te = mean_absolute_error(y_te_dollars, pred_dollars_te)
    r2_dollar_te = r2_score(y_te_dollars, pred_dollars_te)

    print(f'{name:<20s}  R2(log,train)={r2_log_tr:6.3f}  R2(log,test)={r2_log_te:6.3f}  '
          f'R2($,test)={r2_dollar_te:6.3f}  RMSE($,test)={rmse_te:9,.0f}  MAE($,test)={mae_te:9,.0f}')

    return {
        'name': name, 'pipe': pipe,
        'r2_log_train': r2_log_tr, 'r2_log_test': r2_log_te,
        'r2_dollar_test': r2_dollar_te, 'rmse_dollar_test': rmse_te, 'mae_dollar_test': mae_te,
    }


results = []

# ---- Model 1: Linear Regression (baseline) ----------------------------------
lin_pipe = Pipeline([
    ('prep', preprocessor),
    ('model', LinearRegression()),
])
results.append(eval_model('LinearRegression', lin_pipe, X_train, y_train, X_test, y_test, y_test_d))

# ---- Model 2: Ridge Regression, tuned via GridSearchCV ----------------------
ridge_pipe = Pipeline([
    ('prep', preprocessor),
    ('model', Ridge(random_state=RANDOM_STATE)),
])
ridge_param_grid = {'model__alpha': [0.01, 0.1, 1.0, 10.0, 50.0, 100.0]}

ridge_grid = GridSearchCV(ridge_pipe, ridge_param_grid, cv=5, scoring='r2', n_jobs=-1)
ridge_grid.fit(X_train, y_train)

print('Best Ridge alpha:', ridge_grid.best_params_, '  CV R2:', round(ridge_grid.best_score_, 4))
results.append(eval_model('Ridge (tuned)', ridge_grid.best_estimator_, X_train, y_train, X_test, y_test, y_test_d))

# ---- Model 3: Lasso Regression, tuned via GridSearchCV ----------------------
lasso_pipe = Pipeline([
    ('prep', preprocessor),
    ('model', Lasso(random_state=RANDOM_STATE, max_iter=5000)),
])
lasso_param_grid = {'model__alpha': [0.0005, 0.001, 0.005, 0.01, 0.05]}

lasso_grid = GridSearchCV(lasso_pipe, lasso_param_grid, cv=5, scoring='r2', n_jobs=-1)
lasso_grid.fit(X_train, y_train)

print('Best Lasso alpha:', lasso_grid.best_params_, '  CV R2:', round(lasso_grid.best_score_, 4))
results.append(eval_model('Lasso (tuned)', lasso_grid.best_estimator_, X_train, y_train, X_test, y_test, y_test_d))

# ---- Model 4: Random Forest Regressor (non-linear benchmark) ----------------
rf_pipe = Pipeline([
    ('prep', preprocessor),
    ('model', RandomForestRegressor(n_estimators=150, max_depth=18,
                                     min_samples_leaf=3, random_state=RANDOM_STATE, n_jobs=-1)),
])
results.append(eval_model('RandomForest', rf_pipe, X_train, y_train, X_test, y_test, y_test_d))

results_df = pd.DataFrame(results)[
    ['name', 'r2_log_train', 'r2_log_test', 'r2_dollar_test', 'rmse_dollar_test', 'mae_dollar_test']
]
results_df.columns = ['Model', 'R2 (log, train)', 'R2 (log, test)', 'R2 ($, test)',
                       'RMSE ($, test)', 'MAE ($, test)']
print('\n--- Model comparison (pre-polynomial) ---')
print(results_df)

fig, ax = plt.subplots(figsize=(10, 6))
sns.barplot(data=results_df, x='Model', y='R2 ($, test)', ax=ax, palette='viridis')
ax.set_title('Test R-squared (dollar scale) by Model')
ax.set_ylim(0, 1)
for p in ax.patches:
    ax.annotate(f'{p.get_height():.3f}', (p.get_x() + p.get_width() / 2, p.get_height()),
                ha='center', va='bottom')
plt.tight_layout()
savefig('05_model_comparison_r2.png')

print("""
Exploring an additional degree of model complexity: Polynomial features on
numeric predictors + Ridge. To check whether non-linear terms on the numeric
predictors (age, odometer, cylinders) meaningfully improve fit beyond what
Ridge/Lasso capture linearly, degree-2 polynomial and interaction terms are
added to the numeric block only, and Ridge's regularization strength is
re-tuned.
""")

poly_preprocessor = ColumnTransformer(transformers=[
    ('num', Pipeline([
        ('poly', PolynomialFeatures(degree=2, include_bias=False)),
        ('scale', StandardScaler()),
    ]), numeric_features),
    ('cat', OneHotEncoder(handle_unknown='ignore', sparse=True), categorical_features),
])

poly_ridge_pipe = Pipeline([
    ('prep', poly_preprocessor),
    ('model', Ridge(random_state=RANDOM_STATE)),
])
poly_param_grid = {'model__alpha': [0.1, 1.0, 10.0, 50.0]}

poly_grid = GridSearchCV(poly_ridge_pipe, poly_param_grid, cv=5, scoring='r2', n_jobs=-1)
poly_grid.fit(X_train, y_train)

print('Best Poly+Ridge alpha:', poly_grid.best_params_, '  CV R2:', round(poly_grid.best_score_, 4))
results.append(eval_model('Poly(2)+Ridge', poly_grid.best_estimator_, X_train, y_train, X_test, y_test, y_test_d))

results_df = pd.DataFrame(results)[
    ['name', 'r2_log_train', 'r2_log_test', 'r2_dollar_test', 'rmse_dollar_test', 'mae_dollar_test']
]
results_df.columns = ['Model', 'R2 (log, train)', 'R2 (log, test)', 'R2 ($, test)',
                       'RMSE ($, test)', 'MAE ($, test)']
print('\n--- Model comparison (incl. Poly(2)+Ridge) ---')
print(results_df)

